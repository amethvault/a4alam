<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>A4 AALM Invoice</title>
    <style>
        * {
            box-sizing: border-box
        }

        html, body {
            margin: 0;
            padding: 0;
            background: #eee;
            font-family: Arial,"Tahoma",sans-serif;
            color: #080808
        }

        .page {
            width: 712px;
            height: 1018px;
            margin: 18px auto;
            background: #fff;
            padding: 18px 22px 20px;
            box-shadow: 0 2px 12px #0002;
            overflow: hidden
        }

        .header {
            position: relative;
            height: 180px
        }

        .left-contact, .right-contact {
            position: absolute;
            top: 3px;
            width: 226px;
            font-size: 14px;
            line-height: 1.12
        }

        .left-contact {
            left: 0
        }

        .right-contact {
            right: 0
        }

        .center-brand {
            position: absolute;
            top: -15px;
            left: 50%;
            transform: translateX(-50%);
            width: 240px;
            text-align: center
        }

        .row {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            margin-bottom: 9px;
            min-height: 20px
        }

            .row svg {
                width: 19px;
                height: 19px;
                flex: 0 0 19px;
                margin-top: 0
            }

        .left-contact .row span {
            text-align: left
        }

        .right-contact .row {
            justify-content: flex-end;
            gap: 7px
        }

            .right-contact .row span {
                text-align: right;
                white-space: nowrap
            }

            .right-contact .row svg {
                order: 2
            }

        .right-contact .phone span, .right-contact .address span {
            direction: rtl
        }

        .right-contact .email span {
            direction: ltr
        }

        .qr {
            display: block;
            width: 66px;
            height: 66px;
            object-fit: contain;
            margin-top: 3px
        }

        .logo-img {
            width: 92px;
            height: 92px;
            object-fit: contain;
            display: block;
            margin: 0 auto -10px
        }

        .brand {
            font-weight: 900;
            font-size: 21px;
            letter-spacing: .6px;
            line-height: 1
        }

        .ar1 {
            font-family: Tahoma,Arial,sans-serif;
            font-size: 17px;
            font-weight: 700;
            direction: rtl;
            line-height: 1.08;
            margin-top: 5px
        }

        .ar2 {
            font-family: Tahoma,Arial,sans-serif;
            font-size: 16px;
            font-weight: 700;
            direction: rtl;
            line-height: 1.05;
            margin-top: 2px
        }

        .title {
            font-size: 15px;
            font-weight: 700;
            line-height: 1.1;
            margin-top: 4px
        }

        .no-date {
            height: 35px;
            display: grid;
            grid-template-columns: 1fr 245px;
            align-items: center;
            font-size: 14px
        }

        .no {
            font-size: 20px;
            font-weight: 700
        }

        .date-field, .name-field, .tel-field {
            display: flex;
            align-items: center;
            gap: 5px
        }

        .dots {
            flex: 1;
            border-bottom: 1.5px dotted #555;
            height: 12px
        }

        .party {
            height: 42px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            column-gap: 22px;
            align-items: center;
            font-size: 14px
        }

        .party-left {
            display: flex;
            align-items: center;
            gap: 4px
        }

        .party-right {
            display: flex;
            align-items: center;
            gap: 5px;
            direction: rtl
        }

        .table-wrap {
            margin-top: 1px
        }

        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            font-size: 12px;
            border: 1.7px solid #111
        }

        th, td {
            border-left: 1.2px solid #111;
            border-right: 1.2px solid #111
        }

        thead th {
            height: 54px;
            padding: 5px 3px;
            text-align: center;
            font-weight: 500;
            border-bottom: 1.2px solid #111
        }

        th .ar {
            display: block;
            font-family: Tahoma,Arial,sans-serif;
            direction: rtl;
            font-size: 11px;
            margin-top: 2px;
            line-height: 1.05
        }

        tbody td {
            height: 36px;
            border-bottom: 1px dashed #777;
            padding: 2px 4px;
            vertical-align: top;
            outline: none
        }

        tbody tr:last-child td {
            border-bottom: 1.2px solid #111
        }

        .ref {
            width: 10.2%
        }

        .desc {
            width: 44.8%
        }

        .unit {
            width: 9.2%
        }

        .qty {
            width: 8.8%
        }

        .price {
            width: 13.2%
        }

        .amount {
            width: 13.8%
        }

        tfoot td {
            height: 52px;
            border-top: 1.2px solid #111;
            padding: 7px 6px
        }

        .totalbox {
            display: flex;
            align-items: center;
            gap: 7px
        }

            .totalbox .dots {
                height: 11px
            }

        .total-ar {
            font-family: Tahoma,Arial,sans-serif;
            direction: rtl;
            font-weight: 700;
            text-align: right
        }

        .footer {
            display: grid;
            grid-template-columns: 145px 285px 80px 1fr;
            column-gap: 10px;
            margin-top: 23px;
            font-size: 11px;
            align-items: start
        }

        .fitem {
            text-align: center
        }

        .ftitle {
            min-height: 24px;
            white-space: nowrap
        }

            .ftitle .ar {
                font-family: Tahoma,Arial,sans-serif;
                direction: rtl;
                margin-left: 10px
            }

        .sig {
            margin-top: 9px;
            border-bottom: 1px dashed #777;
            height: 13px
        }

        [contenteditable=true]:focus {
            background: #fff8bf;
            outline: none
        }

        @media print {
            html, body {
                background: #fff
            }

            .page {
                margin: 0;
                box-shadow: none;
                width: 210mm;
                height: 297mm;
                padding: 5.3mm 6.5mm
            }
        }

        @media(max-width:740px) {
            body {
                overflow-x: auto
            }

            .page {
                margin: 0
            }
        }
    </style>
</head>
